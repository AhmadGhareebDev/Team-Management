# Copy to .env and fill in.

# Postgres, via the Neon serverless driver.
# https://neon.tech — the connection string looks like
# postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Better Auth. BETTER_AUTH_SECRET signs sessions and email tokens —
# generate one with: openssl rand -base64 32
# BETTER_AUTH_URL must be the origin the app is served from, with no trailing
# slash. It is what password reset and verification links point at.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Ably realtime. The root key, server side only — never expose it with a
# NEXT_PUBLIC_ prefix.
ABLY_API_KEY=

# ImageKit media. The URL endpoint is public and is the only one safe for the
# browser. Uploads are authorised through /api/upload-auth.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Gmail SMTP for verification codes and password resets. GMAIL_APP_PASSWORD is
# a 16 character App Password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret for /api/cron/notifications. Vercel sends it automatically as
# `Authorization: Bearer <CRON_SECRET>` when the variable exists in the project.
CRON_SECRET=

# Optional. Password given to the demo accounts by `npm run demo:seed`.
DEMO_PASSWORD=
